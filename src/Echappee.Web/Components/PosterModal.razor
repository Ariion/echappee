@inherits GameComponent

<div class="modal" role="dialog" aria-modal="true" aria-label="@T("ui.poster")">
    <div class="sheet">
        <div class="poster">@((MarkupString)G.PosterSvg())</div>
        <div class="row2">
            <button class="btn" @onclick="G.Share">@T("btn.share")</button>
            <button class="btn ghost" @onclick="OnClose">@T("btn.close")</button>
        </div>
    </div>
</div>

@code {
    [Parameter] public EventCallback OnClose { get; set; }
}
